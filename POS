def now_str():
    return datetime.now().strftime("%Y-%m-%d %H:%M:%S")


def today_str():
    return date.today().strftime("%Y-%m-%d")


def to_num(v, default=0.0):
    try:
        if v is None:
            return default
        if isinstance(v, (int, float)):
            return float(v)
        s = str(v).replace(",", "").strip()
        return float(s) if s else default
    except ValueError:
        return default


def fmt(n):
    n = to_num(n)
    if abs(n - round(n)) < 0.005:
        return "{:,}".format(int(round(n)))
    return "{:,.2f}".format(n)


def add_months(d, m):
    y = d.year + (d.month - 1 + m) // 12
    mo = (d.month - 1 + m) % 12 + 1
    day = min(d.day, calendar.monthrange(y, mo)[1])
    return d.replace(year=y, month=mo, day=day)


def parse_date(s):
    return datetime.strptime(s.strip(), "%Y-%m-%d").strftime("%Y-%m-%d")


def hash_pw(pw, salt=None):
    salt = salt or os.urandom(16).hex()
    h = hashlib.pbkdf2_hmac("sha256", pw.encode("utf-8"), bytes.fromhex(salt), 120000).hex()
    return h, salt


def line_total(l):
    return round(l["qty"] * l["price"] * (1 - l.get("disc_pct", 0) / 100.0), 2)


def calc_totals(lines, disc_pct, tax_pct):
    sub = round(sum(line_total(l) for l in lines), 2)
    disc_amt = round(sub * disc_pct / 100.0, 2)
    taxable = sub - disc_amt
    tax_amt = round(taxable * tax_pct / 100.0, 2)
    total = round(taxable + tax_amt, 2)
    return {"sub": sub, "disc_amt": disc_amt, "tax_amt": tax_amt, "total": total}


def open_path(p):
    p = str(p)
    try:
        if sys.platform.startswith("win"):
            os.startfile(p)
        elif sys.platform == "darwin":
            subprocess.Popen(["open", p])
        else:
            subprocess.Popen(["xdg-open", p])
    except Exception:
        pass


