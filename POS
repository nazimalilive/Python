        self.tbl.clear()
        st = self.statusv.get()
        sql = "SELECT * FROM repairs WHERE 1=1"
        args = []
        if st == "Pending":
            sql += " AND status NOT IN ('Delivered','Cancelled')"
        elif st != "All":
            sql += " AND status=?"
            args.append(st)
        if self.qv.get().strip():
            sql += " AND (customer_name LIKE ? OR device LIKE ? OR job_no LIKE ? OR imei LIKE ?)"
            args += ["%" + self.qv.get().strip() + "%"] * 4
        sql += " ORDER BY id DESC LIMIT 300"
        for r in self.db.q(sql, args):
            self.tbl.add([r["job_no"], r["date_in"][:16], r["customer_name"], r["device"], r["status"],
                         r["final_charge"] or r["estimate"]], iid=r["id"], tags=("ok",) if r["status"] == "Delivered" else ())

