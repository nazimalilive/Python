class DB:
    def __init__(self, path):
        self.path = str(path)
        self.conn = sqlite3.connect(self.path)
        self.conn.row_factory = sqlite3.Row
        self.conn.execute("PRAGMA foreign_keys=ON")
        self.conn.executescript(SCHEMA)
        self.conn.commit()
        self._seed()

    # ---- basic ----
    def q(self, sql, args=()):
        return self.conn.execute(sql, args).fetchall()

    def one(self, sql, args=()):
        return self.conn.execute(sql, args).fetchone()

    def val(self, sql, args=(), default=0):
        r = self.conn.execute(sql, args).fetchone()
        return default if (r is None or r[0] is None) else r[0]

    def x(self, sql, args=()):
        cur = self.conn.execute(sql, args)
        self.conn.commit()
        return cur

    def _seed(self):
        for k, v in DEFAULT_SETTINGS.items():
            self.conn.execute("INSERT OR IGNORE INTO settings(key,value) VALUES(?,?)", (k, v))
        if not self.val("SELECT COUNT(*) FROM customers"):
            self.conn.execute("INSERT INTO customers(id,name,created) VALUES(1,'Walk-in Customer',?)", (now_str(),))
        if not self.val("SELECT COUNT(*) FROM users"):
            h, s = hash_pw("admin123")
            self.conn.execute(
                "INSERT INTO users(username,full_name,role,pw_hash,salt,active,must_change,created) "
                "VALUES('admin','Administrator','admin',?,?,1,1,?)", (h, s, now_str()))
        self.conn.commit()

    # ---- settings ----
    def get_setting(self, key, default=""):
        r = self.one("SELECT value FROM settings WHERE key=?", (key,))
        return r["value"] if r else default

    def set_setting(self, key, value):
        self.x("INSERT OR REPLACE INTO settings(key,value) VALUES(?,?)", (key, str(value)))

    def settings(self):
        d = dict(DEFAULT_SETTINGS)
        for r in self.q("SELECT key, value FROM settings"):
            d[r["key"]] = r["value"]
        return d

    # ---- users ----
    def check_login(self, username, password):
        r = self.one("SELECT * FROM users WHERE username=? AND active=1", (username,))
        if not r:
            return None
        h, _ = hash_pw(password, r["salt"])
        return r if hmac.compare_digest(h, r["pw_hash"]) else None

    def add_user(self, username, password, role, full_name=""):
        h, s = hash_pw(password)
        self.x("INSERT INTO users(username,full_name,role,pw_hash,salt,active,must_change,created) VALUES(?,?,?,?,?,1,0,?)",
               (username.strip(), full_name.strip(), role, h, s, now_str()))

    def set_password(self, uid, password, must_change=0):
        h, s = hash_pw(password)
        self.x("UPDATE users SET pw_hash=?, salt=?, must_change=? WHERE id=?", (h, s, must_change, uid))

    def admin_count(self):
        return self.val("SELECT COUNT(*) FROM users WHERE role='admin' AND active=1")

    # ---- products ----
    def search_products(self, text="", category="", limit=300):
        sql = "SELECT * FROM products WHERE active=1"
        args = []
        if text:
            sql += " AND (name LIKE ? OR brand LIKE ? OR barcode LIKE ?)"
            args += ["%" + text + "%"] * 3
        if category and category != "All":
            sql += " AND category=?"
            args.append(category)
        sql += " ORDER BY name COLLATE NOCASE LIMIT %d" % limit
        return self.q(sql, args)

    def barcode_taken(self, barcode, exclude_id=None):
        if not barcode:
            return False
        r = self.one("SELECT id FROM products WHERE active=1 AND barcode=? AND id<>?", (barcode, exclude_id or 0))
        return r is not None

    def save_product(self, d, pid=None):
        vals = (d["name"].strip(), d.get("brand", "").strip(), d.get("category") or "Accessory", d.get("barcode", "").strip(),
                to_num(d.get("cost")), to_num(d.get("price")), to_num(d.get("stock")), to_num(d.get("min_stock")),
                1 if d.get("track_imei") else 0, int(to_num(d.get("warranty_months"))))
        if pid:
            self.x("UPDATE products SET name=?, brand=?, category=?, barcode=?, cost=?, price=?, stock=?, min_stock=?, "
                   "track_imei=?, warranty_months=? WHERE id=?", vals + (pid,))
            self.refresh_stock(pid)
            return pid
        cur = self.x("INSERT INTO products(name,brand,category,barcode,cost,price,stock,min_stock,track_imei,warranty_months,created) "
                     "VALUES(?,?,?,?,?,?,?,?,?,?,?)", vals + (now_str(),))
        self.refresh_stock(cur.lastrowid)
        return cur.lastrowid

    def refresh_stock(self, pid, commit=True):
        self.conn.execute(
            "UPDATE products SET stock=(SELECT COUNT(*) FROM imei_units WHERE product_id=? AND status='in_stock') "
            "WHERE id=? AND track_imei=1", (pid, pid))
        if commit:
            self.conn.commit()

    def find_imei(self, imei):
        return self.one("SELECT u.imei, u.cost AS ucost, p.* FROM imei_units u JOIN products p ON p.id=u.product_id "
                        "WHERE u.imei=? AND u.status='in_stock' AND p.active=1", (imei.strip(),))

    def add_imeis(self, pid, imeis, cost=0.0, note="", purchase_id=None, commit=True):
        added, dup = 0, []
        for raw in imeis:
            im = raw.strip()
            if not im:
                continue
            if self.one("SELECT 1 FROM imei_units WHERE imei=?", (im,)):
                dup.append(im)
                continue
            self.conn.execute("INSERT INTO imei_units(product_id,imei,cost,note,status,purchase_id,created) "
                              "VALUES(?,?,?,?, 'in_stock', ?, ?)", (pid, im, cost, note, purchase_id, now_str()))
            added += 1
        self.refresh_stock(pid, commit=False)
        if commit:
            self.conn.commit()
        return added, dup

    # ---- parties ----
    def save_party(self, kind, d, pid=None):
        t = "customers" if kind == "customer" else "suppliers"
        vals = (d["name"].strip(), d.get("phone", "").strip(), d.get("address", "").strip(), to_num(d.get("opening")))
        if pid:
            self.x("UPDATE %s SET name=?, phone=?, address=?, opening=? WHERE id=?" % t, vals + (pid,))
            return pid
        return self.x("INSERT INTO %s(name,phone,address,opening,created) VALUES(?,?,?,?,?)" % t, vals + (now_str(),)).lastrowid

    def parties(self, kind, text="", include_walkin=False):
        sql = (CUST_SQL if kind == "customer" else SUPP_SQL) + " WHERE c.active=1"
        args = []
        if kind == "customer" and not include_walkin:
            sql += " AND c.id<>%d" % WALKIN_ID
        if text:
            sql += " AND (c.name LIKE ? OR c.phone LIKE ?)"
            args += ["%" + text + "%"] * 2
        sql += " ORDER BY c.name COLLATE NOCASE"
        return self.q(sql, args)

    def party_balance(self, kind, pid):
        r = self.one((CUST_SQL if kind == "customer" else SUPP_SQL) + " WHERE c.id=?", (pid,))
        return r["balance"] if r else 0.0

    def add_payment(self, kind, pid, amount, method, note, uid):
        if amount <= 0:
            raise ValueError("Amount must be greater than zero")
        self.x("INSERT INTO payments(date,party_type,party_id,amount,method,note,user_id) VALUES(?,?,?,?,?,?,?)",
               (now_str(), kind, pid, amount, method, note, uid))

    def ledger(self, kind, pid):
        t = "customers" if kind == "customer" else "suppliers"
        op = self.val("SELECT opening FROM %s WHERE id=?" % t, (pid,))
        ev = []
        if kind == "customer":
            for r in self.q("SELECT date, invoice_no, total, paid FROM sales WHERE customer_id=?", (pid,)):
                ev.append((r["date"], 1, "Sale", r["invoice_no"], r["total"], r["paid"]))
            for r in self.q("SELECT r.date, r.balance_adjust, s.invoice_no FROM returns r JOIN sales s ON s.id=r.sale_id "
                            "WHERE s.customer_id=? AND r.balance_adjust>0", (pid,)):
                ev.append((r["date"], 2, "Return", r["invoice_no"], 0, r["balance_adjust"]))
        else:
            for r in self.q("SELECT date, ref_no, total, paid FROM purchases WHERE supplier_id=?", (pid,)):
                ev.append((r["date"], 1, "Purchase", r["ref_no"], r["total"], r["paid"]))
        for r in self.q("SELECT date, amount, method FROM payments WHERE party_type=? AND party_id=?", (kind, pid)):
            ev.append((r["date"], 3, "Payment", r["method"], 0, r["amount"]))
        ev.sort(key=lambda e: (e[0], e[1]))
        rows, bal = [], op
        if op:
            rows.append(["", "Opening", "", op, 0, bal])
        for d, _o, kd, ref, dr, cr in ev:
            bal += dr - cr
            rows.append([d[:16], kd, ref, dr, cr, bal])
        return rows

    # ---- sales ----
    def create_sale(self, cart, customer_id, disc_pct, tax_pct, paid, method, uid, note=""):
        if not cart:
            raise ValueError("Cart is empty")
        t = calc_totals(cart, disc_pct, tax_pct)
        total = t["total"]
        paid = round(min(max(paid, 0.0), total), 2)
        due = round(total - paid, 2)
        if due > 0.004 and customer_id == WALKIN_ID:
            raise ValueError("Walk-in customer must pay in full.\nUdhar / partial payment ke liye customer select karein.")
        need = {}
        for it in cart:
            if not it.get("imei"):
                need[it["pid"]] = need.get(it["pid"], 0) + it["qty"]
        with self.conn:
            for pid, n in need.items():
                p = self.one("SELECT * FROM products WHERE id=?", (pid,))
                if not p:
                    raise ValueError("Product no longer exists")
                if p["track_imei"]:
                    raise ValueError("%s: IMEI / serial select karna zaroori hai" % p["name"])
                if p["category"] not in NO_STOCK_CATS and p["stock"] + 1e-9 < n:
                    raise ValueError("Not enough stock for %s (available %s)" % (p["name"], fmt(p["stock"])))
            lines, cost_total = [], 0.0
            for it in cart:
                cost = it.get("cost", 0.0)
                if it.get("imei"):
                    u = self.one("SELECT * FROM imei_units WHERE imei=? AND status='in_stock'", (it["imei"],))
                    if not u or u["product_id"] != it["pid"]:
                        raise ValueError("IMEI %s is not available in stock" % it["imei"])
                    cost = u["cost"] or cost
                lines.append((it, cost))
                cost_total += cost * it["qty"]
            n = self.val("SELECT COALESCE(MAX(id),0)+1 FROM sales", default=1)
            inv = "%s-%06d" % (self.get_setting("invoice_prefix", "INV") or "INV", n)
            cur = self.conn.execute(
                "INSERT INTO sales(invoice_no,date,customer_id,subtotal,disc_pct,disc_amt,tax_pct,tax_amt,total,paid,balance_due,"
                "cost_total,method,user_id,note) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
                (inv, now_str(), customer_id, t["sub"], disc_pct, t["disc_amt"], tax_pct, t["tax_amt"], total, paid, due,
                 round(cost_total, 2), method, uid, note))
            sale_id = cur.lastrowid
            for it, cost in lines:
                self.conn.execute(
                    "INSERT INTO sale_items(sale_id,product_id,name,imei,qty,price,cost,disc_pct,line_total,warranty_months) "
                    "VALUES(?,?,?,?,?,?,?,?,?,?)",
                    (sale_id, it["pid"], it["name"], it.get("imei") or "", it["qty"], it["price"], cost,
                     it.get("disc_pct", 0), line_total(it), it.get("warranty", 0)))
                if it.get("imei"):
                    self.conn.execute("UPDATE imei_units SET status='sold', sale_id=? WHERE imei=?", (sale_id, it["imei"]))
                    self.refresh_stock(it["pid"], commit=False)
                else:
                    self.conn.execute("UPDATE products SET stock=stock-? WHERE id=? AND category NOT IN ('Service')",
                                      (it["qty"], it["pid"]))
        return sale_id

    def get_sale(self, sale_id):
        sale = self.one(
            "SELECT s.*, c.name AS customer_name, c.phone AS customer_phone, u.full_name AS user_name, u.username AS username "
            "FROM sales s LEFT JOIN customers c ON c.id=s.customer_id LEFT JOIN users u ON u.id=s.user_id WHERE s.id=?",
            (sale_id,))
        items = self.q("SELECT * FROM sale_items WHERE sale_id=? ORDER BY id", (sale_id,))
        return sale, items

    def return_items(self, sale_id, picks, uid, note=""):
        """picks = [(sale_item_id, qty)]  ->  (refund_total, adjusted_to_udhar, cash_refund)"""
        sale = self.one("SELECT * FROM sales WHERE id=?", (sale_id,))
        if not sale:
            raise ValueError("Invoice not found")
        rows = []
        with self.conn:
            for sid, qty in picks:
                it = self.one("SELECT * FROM sale_items WHERE id=? AND sale_id=?", (sid, sale_id))
                if not it or qty <= 0:
                    continue
                if qty > it["qty"] - it["returned_qty"] + 1e-9:
                    raise ValueError("Return qty is more than sold qty")
                net = round(it["line_total"] / it["qty"] * qty * (1 - sale["disc_pct"] / 100.0), 2)
                gross = round(net * (1 + sale["tax_pct"] / 100.0), 2)
                rows.append((it, qty, net, gross, round(it["cost"] * qty, 2)))
            if not rows:
                raise ValueError("Nothing to return")
            refund = round(sum(r[3] for r in rows), 2)
            bal = self.party_balance("customer", sale["customer_id"]) if sale["customer_id"] != WALKIN_ID else 0.0
            adj = round(min(max(bal, 0.0), refund), 2)
            for it, qty, net, gross, cost in rows:
                a = round(adj * gross / refund, 2) if refund else 0.0
                self.conn.execute(
                    "INSERT INTO returns(date,sale_id,sale_item_id,qty,amount,net_amount,cost,balance_adjust,cash_refund,note,user_id) "
                    "VALUES(?,?,?,?,?,?,?,?,?,?,?)",
                    (now_str(), sale_id, it["id"], qty, gross, net, cost, a, round(gross - a, 2), note, uid))
                self.conn.execute("UPDATE sale_items SET returned_qty=returned_qty+? WHERE id=?", (qty, it["id"]))
                if it["imei"]:
                    self.conn.execute("UPDATE imei_units SET status='in_stock', sale_id=NULL WHERE imei=?", (it["imei"],))
                    self.refresh_stock(it["product_id"], commit=False)
                else:
                    self.conn.execute("UPDATE products SET stock=stock+? WHERE id=? AND category NOT IN ('Service')",
                                      (qty, it["product_id"]))
        return refund, adj, round(refund - adj, 2)

    # ---- purchases ----
    def create_purchase(self, supplier_id, lines, disc_pct, paid, method, note, uid):
        if not lines:
            raise ValueError("Purchase is empty")
        subtotal = round(sum(l["qty"] * l["cost"] for l in lines), 2)
        disc_amt = round(subtotal * disc_pct / 100.0, 2)
        total = round(subtotal - disc_amt, 2)
        paid = round(min(max(paid, 0.0), total), 2)
        with self.conn:
            n = self.val("SELECT COALESCE(MAX(id),0)+1 FROM purchases", default=1)
            cur = self.conn.execute(
                "INSERT INTO purchases(ref_no,date,supplier_id,subtotal,disc_pct,disc_amt,total,paid,balance_due,method,user_id,note) "
                "VALUES(?,?,?,?,?,?,?,?,?,?,?,?)",
                ("PUR-%05d" % n, now_str(), supplier_id, subtotal, disc_pct, disc_amt, total, paid, round(total - paid, 2),
                 method, uid, note))
            purchase_id = cur.lastrowid
            for l in lines:
                p = self.one("SELECT * FROM products WHERE id=?", (l["pid"],))
                if not p:
                    raise ValueError("Product missing")
                self.conn.execute("INSERT INTO purchase_items(purchase_id,product_id,name,qty,cost,line_total) VALUES(?,?,?,?,?,?)",
                                  (purchase_id, l["pid"], l["name"], l["qty"], l["cost"], round(l["qty"] * l["cost"], 2)))
                if p["track_imei"]:
                    added, dup = self.add_imeis(l["pid"], l.get("imeis", []), l["cost"], l.get("note", ""), purchase_id, commit=False)
                    if dup:
                        raise ValueError("These IMEI already exist:\n" + "\n".join(dup[:8]))
                else:
                    self.conn.execute("UPDATE products SET stock=stock+? WHERE id=?", (l["qty"], l["pid"]))
                self.conn.execute("UPDATE products SET cost=? WHERE id=?", (l["cost"], l["pid"]))
        return purchase_id

    # ---- repairs ----
    def save_repair(self, d, uid, rid=None):
        status = d.get("status") or "Received"
        date_out = None
        if rid:
            date_out = self.one("SELECT date_out FROM repairs WHERE id=?", (rid,))["date_out"]
        final = to_num(d.get("final_charge"))
        if status == "Delivered":
            date_out = date_out or now_str()
            if not final:
                final = to_num(d.get("estimate"))
        else:
            date_out = None
        vals = (d["customer_name"].strip(), d.get("phone", "").strip(), d["device"].strip(), d.get("imei", "").strip(),
                d.get("problem", "").strip(), to_num(d.get("estimate")), to_num(d.get("advance")), final,
                to_num(d.get("parts_cost")), status, d.get("technician", "").strip(), date_out, d.get("note", "").strip())
        if rid:
            self.x("UPDATE repairs SET customer_name=?, phone=?, device=?, imei=?, problem=?, estimate=?, advance=?, final_charge=?, "
                   "parts_cost=?, status=?, technician=?, date_out=?, note=? WHERE id=?", vals + (rid,))
            return rid
        n = self.val("SELECT COALESCE(MAX(id),0)+1 FROM repairs", default=1)
        return self.x("INSERT INTO repairs(customer_name,phone,device,imei,problem,estimate,advance,final_charge,parts_cost,status,"
                      "technician,date_out,note,job_no,date_in,user_id) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
                      vals + ("JOB-%04d" % n, now_str(), uid)).lastrowid

    # ---- lookups / stats ----
    def imei_lookup(self, imei):
        u = self.one("SELECT u.*, p.name AS pname, p.brand AS pbrand FROM imei_units u JOIN products p ON p.id=u.product_id "
                     "WHERE u.imei=?", (imei.strip(),))
        if not u:
            return None
        info = dict(u)
        info.update(invoice="", sold_on="", customer="", phone="", warranty_until=None, warranty_active=False, wm=0)
        if u["sale_id"]:
            s = self.one("SELECT s.invoice_no, s.date, c.name AS cname, c.phone AS cphone FROM sales s "
                         "LEFT JOIN customers c ON c.id=s.customer_id WHERE s.id=?", (u["sale_id"],))
            it = self.one("SELECT warranty_months FROM sale_items WHERE sale_id=? AND imei=?", (u["sale_id"], u["imei"]))
            wm = it["warranty_months"] if it else 0
            info.update(invoice=s["invoice_no"], sold_on=s["date"], customer=s["cname"], phone=s["cphone"], wm=wm)
            if wm:
                exp = add_months(datetime.strptime(s["date"][:10], "%Y-%m-%d").date(), wm)
                info["warranty_until"] = exp
                info["warranty_active"] = exp >= date.today()
        return info

    def summary(self, d1, d2):
        s = self.one("SELECT COUNT(*) n, COALESCE(SUM(total),0) total, COALESCE(SUM(total-tax_amt),0) net, "
                     "COALESCE(SUM(cost_total),0) cost, COALESCE(SUM(disc_amt),0) disc FROM sales "
                     "WHERE substr(date,1,10) BETWEEN ? AND ?", (d1, d2))
        r = self.one("SELECT COALESCE(SUM(amount),0) gross, COALESCE(SUM(net_amount),0) net, COALESCE(SUM(cost),0) cost "
                     "FROM returns WHERE substr(date,1,10) BETWEEN ? AND ?", (d1, d2))
        rp = self.one("SELECT COUNT(*) n, COALESCE(SUM(final_charge),0) rev, COALESCE(SUM(parts_cost),0) cost FROM repairs "
                      "WHERE status='Delivered' AND substr(date_out,1,10) BETWEEN ? AND ?", (d1, d2))
        ex = self.val("SELECT COALESCE(SUM(amount),0) FROM expenses WHERE date BETWEEN ? AND ?", (d1, d2))
        goods = s["net"] - r["net"] - (s["cost"] - r["cost"])
        repair = rp["rev"] - rp["cost"]
        return {
            "invoices": s["n"], "gross_sales": s["total"], "returns": r["gross"], "net_sales": s["total"] - r["gross"],
            "discount": s["disc"], "goods_profit": goods, "repair_jobs": rp["n"], "repair_rev": rp["rev"],
            "repair_profit": repair, "gross_profit": goods + repair, "expenses": ex, "net_profit": goods + repair - ex,
            "cogs": s["cost"] - r["cost"], "sales_ex_tax": s["net"], "returns_net": r["net"],
        }

    def receivable(self):
        return self.val("SELECT COALESCE(SUM(balance),0) FROM (" + CUST_SQL + " WHERE c.active=1) WHERE balance>0.005")

    def payable(self):
        return self.val("SELECT COALESCE(SUM(balance),0) FROM (" + SUPP_SQL + " WHERE c.active=1) WHERE balance>0.005")

    def stock_value(self):
        a = self.val("SELECT COALESCE(SUM(stock*cost),0) FROM products WHERE active=1 AND track_imei=0 AND category<>'Service'")
        b = self.val("SELECT COALESCE(SUM(u.cost),0) FROM imei_units u JOIN products p ON p.id=u.product_id "
                     "WHERE u.status='in_stock' AND p.active=1")
        return a + b

    def low_stock(self):
        return self.q("SELECT * FROM products WHERE active=1 AND category<>'Service' AND min_stock>0 AND stock<=min_stock "
                      "ORDER BY name COLLATE NOCASE")

    def pending_repairs(self):
        return self.val("SELECT COUNT(*) FROM repairs WHERE status IN ('Received','In Progress','Waiting for Parts','Ready')")


def backup_db(db, keep=30, tag="auto"):
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    dest = BACKUP_DIR / ("backup_%s_%s.db" % (datetime.now().strftime("%Y%m%d_%H%M%S"), tag))
    dst = sqlite3.connect(str(dest))
    try:
        db.conn.backup(dst)
    finally:
        dst.close()
    for f in sorted(BACKUP_DIR.glob("backup_*.db"))[:-keep]:
        try:
            f.unlink()
        except OSError:
            pass
    return dest


