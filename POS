            return
        self.build_shell()
        self._maybe_daily_backup()
        if st["state"] == "trial" and st["days"] <= 3:
            self.after(400, lambda: messagebox.showwarning(
                "Trial", "Trial sirf %d din baaki hai. Jald activate karein." % st["days"], parent=self))

    def show_license_gate(self, st):
        for w in self.winfo_children():
            w.destroy()
        LicenseGateScreen(self, st, lambda: self.on_login_success(self.user))

    def force_password_change(self, first_time=False):
        while True:
            res = ask_form(self, "Password Change Zaroori" if first_time else "Change Password",
                            [{"key": "p1", "label": "New password", "type": "password", "required": True},
                             {"key": "p2", "label": "Confirm password", "type": "password", "required": True}],
                            ok_text="Change")
            if res is None:
                if not first_time:
                    return
                if messagebox.askyesno("Cancel", "Password change zaroori hai.\nLogout karein?", parent=self):
                    self.user = None
                    self.show_login()
                    return
                continue
            if len(res["p1"]) < 4:
                messagebox.showwarning("Weak password", "Kam se kam 4 characters ka password rakhein.", parent=self)
                continue
            if res["p1"] != res["p2"]:
                messagebox.showwarning("Mismatch", "Dono password same nahi hain.", parent=self)
                continue
            self.db.set_password(self.user["id"], res["p1"], must_change=0)
            self.user["must_change"] = 0
            messagebox.showinfo("Done", "Password change ho gaya.", parent=self)
            return

    def _maybe_daily_backup(self):
        try:
            today = today_str()
            done = any(today in f.name for f in BACKUP_DIR.glob("backup_*_daily.db"))
            if not done:
                self.after(600, lambda: backup_db(self.db, tag="daily"))
        except Exception:
            pass

