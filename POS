class CartLineDialog(Modal):
    def __init__(self, parent, item):
        super().__init__(parent)
        self.title(item["name"])
        self.configure(bg=C["card"])
        self.resizable(False, False)
        self.item, self.result = dict(item), None
        body = tk.Frame(self, bg=C["card"], padx=20, pady=14)
        body.pack(fill="both", expand=True)
        head = item["name"] + ((" - IMEI " + item["imei"]) if item.get("imei") else "")
        tk.Label(body, text=head, font=FONT_B, bg=C["card"], wraplength=280, justify="left")\
            .grid(row=0, column=0, columnspan=2, sticky="w", pady=(0, 10))
        self.qv = tk.StringVar(value=plain(item["qty"]))
        self.pv = tk.StringVar(value=plain(item["price"]))
        self.dv = tk.StringVar(value=plain(item.get("disc_pct", 0)))
        for i, (lbl, var) in enumerate([("Qty", self.qv), ("Price", self.pv), ("Discount %", self.dv)], start=1):
            tk.Label(body, text=lbl, bg=C["card"], fg=C["mute"], font=FONT_S).grid(row=i, column=0, sticky="w", pady=4)
            e = entry(body, var, width=14, justify="right")
            e.grid(row=i, column=1, sticky="e", pady=4)
            if item.get("imei") and lbl == "Qty":
                e.config(state="readonly")
        bar = tk.Frame(self, bg=C["card"])
        bar.pack(fill="x", padx=20, pady=(4, 16))
        btn(bar, "Save", self.save, "primary").pack(side="right")
        btn(bar, "Remove", self.remove, "danger").pack(side="right", padx=8)
        btn(bar, "Cancel", self.destroy, "neutral").pack(side="left")
        self.bind("<Return>", lambda e: self.save())
        self.bind("<Escape>", lambda e: self.destroy())
        self.go_modal(parent, 340, 260)

    def save(self, _e=None):
        if not re.fullmatch(r"[\d,]*\.?\d*", self.qv.get().strip()) or \
           not re.fullmatch(r"[\d,]*\.?\d*", self.pv.get().strip()):
            messagebox.showwarning("Invalid", "Sahi number likhein.", parent=self)
            return
        qty = max(0.001, to_num(self.qv.get(), 1))
        price = max(0.0, to_num(self.pv.get(), 0))
        disc = min(100.0, max(0.0, to_num(self.dv.get(), 0)))
        if self.item.get("imei"):
            qty = 1
        it = dict(self.item)
        it.update(qty=qty, price=price, disc_pct=disc)
        self.result = ("save", it)
        self.destroy()

    def remove(self):
        self.result = ("remove", None)
        self.destroy()


