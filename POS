class FormDialog(Modal):
    """Generic form.  fields = [{key,label,type(entry|num|int|combo|text|check|password),values,required,full,default}]"""

    def __init__(self, parent, title, fields, initial=None, ok_text="Save", validate=None):
        super().__init__(parent)
        self.title(title)
        self.configure(bg=C["card"])
        self.resizable(False, False)
        self.result, self.fields, self.validate, self.w = None, fields, validate, {}
        init = initial or {}
        body = tk.Frame(self, bg=C["card"], padx=22, pady=12)
        body.pack(fill="both", expand=True)
        ncols = 2 if len(fields) > 5 else 1
        r = c = 0
        first = None
        for f in fields:
            kind = f.get("type", "entry")
            span = ncols if (f.get("full") or kind == "text") else 1
            if c + span > ncols:
                r += 2
                c = 0
            padl = 0 if c == 0 else 14
            tk.Label(body, text=f["label"] + (" *" if f.get("required") else ""), bg=C["card"], fg=C["mute"],
                     font=FONT_S).grid(row=r, column=c, columnspan=span, sticky="w", padx=(padl, 0), pady=(8, 0))
            widget = self._make(body, f, kind, init.get(f["key"], f.get("default", "")))
            widget.grid(row=r + 1, column=c, columnspan=span, sticky="ew", padx=(padl, 0))
            c += span
            if c >= ncols:
                r += 2
                c = 0
            if first is None and kind != "check":
                first = widget
        for i in range(ncols):
            body.grid_columnconfigure(i, weight=1)
        bar = tk.Frame(self, bg=C["card"])
        bar.pack(fill="x", padx=22, pady=(4, 16))
        btn(bar, ok_text, self.save, "primary").pack(side="right")
        btn(bar, "Cancel", self.destroy, "neutral").pack(side="right", padx=8)
        self.bind("<Return>", self._on_return)
        self.bind("<Escape>", lambda e: self.destroy())
        self.go_modal(parent)
        if first is not None:
            first.focus_set()

    def _make(self, body, f, kind, val):
        key = f["key"]
        if kind == "text":
            t = tk.Text(body, width=44, height=f.get("height", 4), font=FONT, relief="flat", highlightthickness=1,
                        highlightbackground=C["line"], highlightcolor=C["accent"], wrap="word")
            t.insert("1.0", plain(val))
            self.w[key] = ("text", t)
            return t
        if kind == "combo":
            v = tk.StringVar(value=plain(val))
            cb = ttk.Combobox(body, textvariable=v, values=f.get("values", []),
                              state="normal" if f.get("editable") else "readonly", width=24)
            self.w[key] = ("var", v)
            return cb
        if kind == "check":
            v = tk.IntVar(value=1 if to_num(val) else 0)
            cb = tk.Checkbutton(body, text=f.get("text", ""), variable=v, bg=C["card"], activebackground=C["card"],
                                font=FONT, anchor="w")
            self.w[key] = ("var", v)
            return cb
        v = tk.StringVar(value=plain(val))
        e = entry(body, v, width=26, show="*" if kind == "password" else None)
        if f.get("readonly"):
            e.config(state="readonly")
        self.w[key] = ("var", v)
        return e

    def _on_return(self, e):
        if not isinstance(e.widget, tk.Text):
            self.save()

    def save(self, _e=None):
        data = {}
        for f in self.fields:
            k, kind = f["key"], f.get("type", "entry")
            typ, w = self.w[k]
            raw = w.get("1.0", "end").strip() if typ == "text" else w.get()
            if isinstance(raw, str):
                raw = raw.strip()
            if f.get("required") and raw == "":
                messagebox.showwarning("Required", "%s is required" % f["label"], parent=self)
                return
            if kind in ("num", "int"):
                if raw != "" and not re.fullmatch(r"-?[\d,]*\.?\d*", str(raw)):
                    messagebox.showwarning("Invalid number", "%s: sirf number likhein" % f["label"], parent=self)
                    return
                raw = to_num(raw)
                if kind == "int":
                    raw = int(raw)
            elif kind == "check":
                raw = int(raw)
            data[k] = raw
        if self.validate:
            err = self.validate(data)
            if err:
                messagebox.showwarning("Check input", err, parent=self)
                return
        self.result = data
        self.destroy()


def ask_form(parent, title, fields, initial=None, ok_text="Save", validate=None):
    d = FormDialog(parent, title, fields, initial, ok_text, validate)
    d.wait_window()
    return d.result


class PickDialog(Modal):
    """Searchable list; fetch(text) -> [(iid, values)]; returns chosen iid (str) or None."""

    def __init__(self, parent, title, cols, fetch, new_cb=None, w=640, h=500):
        super().__init__(parent)
        self.title(title)
        self.configure(bg=C["card"])
        self.result, self.fetch, self.new_cb = None, fetch, new_cb
        top = tk.Frame(self, bg=C["card"])
        top.pack(fill="x", padx=14, pady=(14, 6))
        self.q = tk.StringVar()
        self.e = entry(top, self.q, width=40)
        self.e.pack(side="left", fill="x", expand=True, ipady=4)
        if new_cb:
            btn(top, "+ New", self.do_new, "success").pack(side="left", padx=(8, 0))
        self.tbl = Table(self, cols, height=12, on_double=self.choose)
        self.tbl.pack(fill="both", expand=True, padx=14, pady=6)
        bar = tk.Frame(self, bg=C["card"])
        bar.pack(fill="x", padx=14, pady=(0, 14))
        btn(bar, "Select", self.choose, "primary").pack(side="right")
        btn(bar, "Cancel", self.destroy, "neutral").pack(side="right", padx=8)
        self.e.bind("<KeyRelease>", lambda ev: self.load())
        self.e.bind("<Return>", lambda ev: self.choose())
        self.e.bind("<Down>", lambda ev: self.tbl.tree.focus_set())
        self.tbl.tree.bind("<Return>", lambda ev: self.choose())
        self.bind("<Escape>", lambda ev: self.destroy())
        self.load()
        self.go_modal(parent, w, h)
        self.e.focus_set()

    def load(self):
        self.tbl.clear()
        for iid, vals in self.fetch(self.q.get().strip()):
            self.tbl.add(vals, iid=iid)
        self.tbl.select_first()

    def choose(self):
        sel = self.tbl.selected()
        if sel:
            self.result = sel
            self.destroy()

    def do_new(self):
        nid = self.new_cb(self)
        if nid:
            self.result = str(nid)
            self.destroy()


def ask_pick(parent, title, cols, fetch, new_cb=None, w=640, h=500):
    d = PickDialog(parent, title, cols, fetch, new_cb, w, h)
    d.wait_window()
    return d.result


