def machine_id():
    raw = "%s|%s|%s" % (uuid.getnode(), platform.system(), platform.machine())
    h = hashlib.sha256(raw.encode()).hexdigest().upper()[:16]
    return "-".join(h[i:i + 4] for i in range(0, 16, 4))


def _sig(mid, expiry):
    return hmac.new(LICENSE_SECRET, ("%s|%s" % (mid, expiry)).encode(), hashlib.sha256).hexdigest().upper()[:20]


def make_license_key(mid, expiry="LIFETIME"):
    s = _sig(mid.strip().upper(), expiry)
    return "%s-%s" % (expiry, "-".join(s[i:i + 5] for i in range(0, 20, 5)))


def verify_license_key(key, mid=None):
    mid = (mid or machine_id()).strip().upper()
    parts = key.strip().upper().split("-")
    if len(parts) != 5:
        return False, "Invalid key format", ""
    expiry, sig = parts[0], "".join(parts[1:])
    if expiry != "LIFETIME":
        try:
            exp_date = datetime.strptime(expiry, "%Y%m%d").date()
        except ValueError:
            return False, "Invalid key", ""
        if exp_date < date.today():
            return False, "This key expired on %s" % exp_date, expiry
    if not hmac.compare_digest(sig, _sig(mid, expiry)):
        return False, "This key is not valid for this computer", ""
    return True, "OK", expiry


def _read_marker():
    d = {}
    try:
        for line in MARKER.read_text().splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                d[k.strip()] = v.strip()
    except Exception:
        pass
    return d


def _write_marker(d):
    try:
        MARKER.write_text("\n".join("%s=%s" % kv for kv in d.items()))
    except Exception:
        pass


def license_status(db):
    """returns dict(state = licensed | trial | expired | tampered, days, text)"""
    key = db.get_setting("license_key", "")
    if key:
        ok, _msg, exp = verify_license_key(key)
        if ok:
            if exp == "LIFETIME":
                return {"state": "licensed", "days": 99999, "text": "Licensed (Lifetime)"}
            left = (datetime.strptime(exp, "%Y%m%d").date() - date.today()).days
            return {"state": "licensed", "days": left, "text": "Licensed - %d days left" % left}
    today = today_str()
    mk = _read_marker()
    starts = [x for x in (db.get_setting("trial_start", ""), mk.get("start", "")) if x]
    start = min(starts) if starts else today
    lasts = [x for x in (db.get_setting("last_run", ""), mk.get("last", "")) if x]
    last = max(lasts) if lasts else start
    if today < last:
        return {"state": "tampered", "days": 0, "text": "System date was changed - set the correct date"}
    db.set_setting("trial_start", start)
    db.set_setting("last_run", today)
    _write_marker({"start": start, "last": today})
    used = (date.today() - datetime.strptime(start, "%Y-%m-%d").date()).days
    left = TRIAL_DAYS - used
    if left < 0:
        return {"state": "expired", "days": 0, "text": "Trial expired - please activate a license"}
    return {"state": "trial", "days": left, "text": "Trial version: %d day(s) left" % left}


def activate_license(db, key):
    ok, msg, _ = verify_license_key(key)
    if ok:
        db.set_setting("license_key", key.strip().upper())
    return ok, msg


