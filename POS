        self.paidv = tk.StringVar(value="0")
        pe = entry(row, self.paidv, width=12, justify="right")
        pe.pack(side="right")
        pe.bind("<KeyPress>", lambda e: setattr(self, "_paid_touched", True))
        pe.bind("<Return>", lambda e: self.complete_sale())

        btn(right, "Complete Sale", self.complete_sale, "success").pack(fill="x", pady=(14, 4), ipady=6)
        btn(right, "Clear Cart", self.clear_cart, "neutral", small=True).pack(fill="x")

        self.search_entry.focus_set()
        self.refresh_cart()

    # ---- search / add ----
    def search(self):
        self.results.clear()
        text = self.qv.get().strip()
        if not text:
            return
        for p in self.db.search_products(text, limit=8):
            self.results.add([p["name"], p["brand"], p["price"], "IMEI" if p["track_imei"] else p["stock"]], iid=p["id"])

    def on_enter_search(self):
        text = self.qv.get().strip()
        if not text:
            return
        hit = self.db.find_imei(text)
        if hit:
            self._add_product(dict(hit), imei=hit["imei"], cost=hit["ucost"])
            self.qv.set("")
            self.results.clear()
            return
        if self.results.count():
            self.results.select_first()
            self.add_selected()
            return
        p = self.db.one("SELECT * FROM products WHERE active=1 AND barcode=?", (text,))
        if p:
            self._add_by_product(dict(p))
            self.qv.set("")
        else:
            messagebox.showinfo("Not found", "Koi product/IMEI/barcode match nahi hua.", parent=self)

    def add_selected(self):
        iid = self.results.selected()
        if not iid:
            return
        p = self.db.one("SELECT * FROM products WHERE id=?", (int(iid),))
        if not p:
            return
        self._add_by_product(dict(p))
        self.qv.set("")
        self.results.clear()
        self.search_entry.focus_set()

    def _add_by_product(self, p):
        if p["track_imei"]:
            fetch = lambda t: [(u["imei"], (u["imei"], u["note"], u["cost"])) for u in self.db.q(
                "SELECT * FROM imei_units WHERE product_id=? AND status='in_stock' AND imei LIKE ? ORDER BY id",
                (p["id"], "%" + t + "%"))]
            imei = ask_pick(self, "Select IMEI / Serial - " + p["name"],
                            [("imei", "IMEI/Serial", 160, "w"), ("note", "Note", 120, "w"), ("cost", "Cost", 70, "e")], fetch)
            if not imei:
                return
            u = self.db.one("SELECT * FROM imei_units WHERE imei=?", (imei,))
            self._add_product(p, imei=u["imei"], cost=u["cost"])
        else:
            if p["category"] not in NO_STOCK_CATS and p["stock"] <= 0:
                if not messagebox.askyesno("Out of stock", "%s stock me nahi hai. Phir bhi add karein?" % p["name"], parent=self):
                    return
            for it in self.cart:
                if it["pid"] == p["id"] and not it.get("imei"):
                    it["qty"] += 1
                    self.refresh_cart()
                    return
            self._add_product(p, cost=p["cost"])

    def _add_product(self, p, imei="", cost=None):
        self.cart.append({"pid": p["id"], "name": p["name"], "imei": imei, "qty": 1, "price": p["price"],
                          "cost": cost if cost is not None else p["cost"], "disc_pct": 0,
                          "warranty": p["warranty_months"] or 0})
        self.refresh_cart()

    def _edit_selected_line(self):
        iid = self.cart_tbl.selected()
        if iid is None:
            return
        idx = int(iid)
        d = CartLineDialog(self, self.cart[idx])
        d.wait_window()
        if d.result is None:
            return
        action, data = d.result
        if action == "remove":
            del self.cart[idx]
        else:
            self.cart[idx] = data
        self.refresh_cart()

    # ---- customer / totals ----
    def pick_cust(self):
        cid = pick_customer(self, self.db)
        if cid:
            self.customer_id = cid
            row = self.db.one("SELECT name FROM customers WHERE id=?", (cid,))
            self.customer_name = row["name"] if row else "Walk-in Customer"
            self.cust_lbl.config(text=self.customer_name)

    def refresh_cart(self):
        self.cart_tbl.clear()
        for i, it in enumerate(self.cart):
            self.cart_tbl.add([it["name"], it.get("imei") or "", it["qty"], it["price"],
                              it.get("disc_pct") or "", line_total(it)], iid=i)
        self.recalc()

    def recalc(self):
        disc, tax = to_num(self.discv.get()), to_num(self.taxv.get())
        t = calc_totals(self.cart, disc, tax) if self.cart else {"sub": 0, "disc_amt": 0, "tax_amt": 0, "total": 0}
        self.lbl_sub.config(text=fmt(t["sub"]))
        self.lbl_disc.config(text=fmt(t["disc_amt"]))
        self.lbl_tax.config(text=fmt(t["tax_amt"]))
        self.lbl_total.config(text=fmt(t["total"]))
        if not self._paid_touched:
            self.paidv.set(fmt(t["total"]))

    def clear_cart(self):
        if self.cart and not messagebox.askyesno("Clear", "Cart clear kar dein?", parent=self):
            return
        self.cart = []
        self._paid_touched = False
        self.customer_id, self.customer_name = WALKIN_ID, "Walk-in Customer"
        self.cust_lbl.config(text=self.customer_name)
        self.discv.set("0")
        self.refresh_cart()
        self.search_entry.focus_set()

    def complete_sale(self):
        if not self.cart:
            messagebox.showinfo("Empty", "Cart khali hai.", parent=self)
            return
        disc, tax, paid = to_num(self.discv.get()), to_num(self.taxv.get()), to_num(self.paidv.get())
        try:
            sale_id = self.db.create_sale(self.cart, self.customer_id, disc, tax, paid, self.methodv.get(),
                                          self.app.user["id"])
        except ValueError as e:
            messagebox.showerror("Sale", str(e), parent=self)
            return
        self.clear_cart()
        InvoiceDialog(self.app, self.app, sale_id, done=True)


