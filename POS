    def refresh(self):
        try:
            d1, d2 = parse_date(self.d1.get()), parse_date(self.d2.get())
        except ValueError:
            messagebox.showwarning("Date", "YYYY-MM-DD format use karein.", parent=self)
            return
        sql = ("SELECT s.id, s.invoice_no, s.date, s.total, s.paid, s.balance_due, s.method, c.name cn "
              "FROM sales s LEFT JOIN customers c ON c.id=s.customer_id WHERE substr(s.date,1,10) BETWEEN ? AND ?")
        args = [d1, d2]
        if self.qv.get().strip():
            sql += " AND (s.invoice_no LIKE ? OR c.name LIKE ?)"
            args += ["%" + self.qv.get().strip() + "%"] * 2
        sql += " ORDER BY s.id DESC LIMIT 500"
        self.tbl.clear()
        tot = 0.0
        for r in self.db.q(sql, args):
            self.tbl.add([r["invoice_no"], r["date"][:16], r["cn"], r["total"], r["paid"], r["balance_due"], r["method"]],
                        iid=r["id"])
            tot += r["total"]
        self.total_lbl.config(text="%d invoice(s)   Total sales: %s" % (self.tbl.count(), fmt(tot)))

    def open_selected(self):
        iid = self.tbl.selected()
        if not iid:
            return
        InvoiceDialog(self.app, self.app, int(iid), done=False)

    def export(self):
        rows = self.db.q("SELECT s.invoice_no, s.date, c.name cn, s.total, s.paid, s.balance_due, s.method "
                         "FROM sales s LEFT JOIN customers c ON c.id=s.customer_id ORDER BY s.id DESC LIMIT 5000")
        export_csv(self, ["Invoice", "Date", "Customer", "Total", "Paid", "Due", "Method"],
                  [[r["invoice_no"], r["date"][:16], r["cn"], r["total"], r["paid"], r["balance_due"], r["method"]] for r in rows],
                  "sales")
