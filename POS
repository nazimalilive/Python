def monogram(parent, size=64, color=None, text=None, bg=None):
    """Small branded circle badge with initials, e.g. for the login screen / sidebar header."""
    color = color or C["accent"]
    bg = bg if bg is not None else parent.cget("bg")
    cv = tk.Canvas(parent, width=size, height=size, bg=bg, highlightthickness=0)
    pad = max(1, size // 32)
    cv.create_oval(pad, pad, size - pad, size - pad, fill=color, outline="")
    cv.create_text(size / 2, size / 2, text=text or APP_INITIALS, fill="white",
                   font=("Segoe UI", max(8, int(size * 0.34)), "bold"))
    return cv


