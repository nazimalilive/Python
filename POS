def rep_sales_summary(db, d1, d2):
    hdr = ["Date", "Invoices", "Gross Sales", "Discount", "Returns", "Net Sales", "Profit"]
    sales = dict((r["d"], r) for r in db.q(
        "SELECT substr(date,1,10) d, COUNT(*) n, SUM(total) total, SUM(disc_amt) disc, SUM(total-tax_amt-cost_total) profit "
        "FROM sales WHERE substr(date,1,10) BETWEEN ? AND ? GROUP BY d", (d1, d2)))
    rets = dict((r["d"], r) for r in db.q(
        "SELECT substr(date,1,10) d, SUM(amount) gross, SUM(net_amount-cost) prof FROM returns "
        "WHERE substr(date,1,10) BETWEEN ? AND ? GROUP BY d", (d1, d2)))
    rows = []
    for d in sorted(set(sales) | set(rets)):
        s, r = sales.get(d), rets.get(d)
        g = s["total"] if s else 0
        rr = r["gross"] if r else 0
        rows.append([d, s["n"] if s else 0, g, s["disc"] if s else 0, rr, g - rr,
                     (s["profit"] if s else 0) - (r["prof"] if r else 0)])
    tot = ["TOTAL"] + [sum(r[i] for r in rows) for i in range(1, 7)] if rows else None
    return hdr, rows, tot


def rep_sales_detail(db, d1, d2):
    hdr = ["Invoice", "Date", "Customer", "Total", "Paid", "Due", "Method", "User"]
    rows = [[r["invoice_no"], r["date"][:16], r["cn"], r["total"], r["paid"], r["balance_due"], r["method"], r["un"]]
            for r in db.q("SELECT s.*, c.name cn, u.username un FROM sales s LEFT JOIN customers c ON c.id=s.customer_id "
                          "LEFT JOIN users u ON u.id=s.user_id WHERE substr(s.date,1,10) BETWEEN ? AND ? ORDER BY s.id", (d1, d2))]
    tot = ["TOTAL", "", "", sum(r[3] for r in rows), sum(r[4] for r in rows), sum(r[5] for r in rows), "", ""] if rows else None
    return hdr, rows, tot


def rep_profit_product(db, d1, d2):
    hdr = ["Product", "Qty Sold", "Revenue", "Cost", "Profit"]
    rows = []
    for r in db.q("SELECT si.name, SUM(si.qty-si.returned_qty) q, SUM((si.qty-si.returned_qty)*si.price*(1-si.disc_pct/100.0)) rev, "
                  "SUM((si.qty-si.returned_qty)*si.cost) cost FROM sale_items si JOIN sales s ON s.id=si.sale_id "
                  "WHERE substr(s.date,1,10) BETWEEN ? AND ? GROUP BY si.product_id, si.name ORDER BY rev DESC", (d1, d2)):
        rows.append([r["name"], r["q"], r["rev"], r["cost"], r["rev"] - r["cost"]])
    tot = ["TOTAL", sum(r[1] for r in rows), sum(r[2] for r in rows), sum(r[3] for r in rows), sum(r[4] for r in rows)] if rows else None
    return hdr, rows, tot


