            b.bind("<Leave>", lambda e, w=b, k=item["key"]: (w.config(bg=C["side"]) if k != self.current_key else None))
            self.nav_btns[item["key"]] = b
            if item.get("hotkey"):
                self.bind_all("<%s>" % item["hotkey"], lambda e, k=item["key"]: self.show_page(k))

        tk.Frame(self.sidebar, bg=C["side2"], height=1).pack(fill="x", pady=8)
