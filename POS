        self._headers, self._rows = [], []

    def refresh(self):
        self.run()

    def run(self):
        try:
            d1, d2 = parse_date(self.d1.get()), parse_date(self.d2.get())
        except ValueError:
            messagebox.showwarning("Date", "YYYY-MM-DD format use karein.", parent=self)
            return
        fn = dict(REPORTS)[self.repv.get()]
        headers, rows, tot = fn(self.db, d1, d2)
        self._headers, self._rows = headers, rows
        if self.tbl is not None:
            self.tbl.destroy()
        self.tbl = Table(self.tbl_frame, [(str(i), h, 120, "e" if i > 0 else "w") for i, h in enumerate(headers)], height=16)
        self.tbl.pack(fill="both", expand=True)
        for r in rows:
            self.tbl.add(r)
        if tot:
            self.tbl.add(tot, tags=("total",))

    def print_it(self):
        if not self._headers:
            self.run()
        print_table(self.db, self.repv.get(), self._headers, self._rows, "%s to %s" % (self.d1.get(), self.d2.get()))

    def export(self):
        if not self._headers:
            self.run()
        export_csv(self, self._headers, self._rows, self.repv.get().replace(" ", "_"))


