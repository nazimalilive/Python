def receipt_text(sale, items, cfg):
    sale = dict(sale)
    cur = cfg.get("currency", "Rs")
    L = ["*%s*" % cfg.get("shop_name", ""), "%s | %s" % (cfg.get("shop_address", ""), cfg.get("shop_phone", "")), "",
         "Invoice: %s" % sale["invoice_no"], "Date: %s" % sale["date"][:16], "Customer: %s" % (sale.get("customer_name") or ""), ""]
    for i, it in enumerate(items, 1):
        s = "%d. %s x%s = %s %s" % (i, it["name"], fmt(it["qty"]), cur, fmt(it["line_total"]))
        if it["imei"]:
            s += "\n    IMEI: %s" % it["imei"]
        L.append(s)
    L.append("------------------")
    L.append("Subtotal: %s %s" % (cur, fmt(sale["subtotal"])))
    if sale["disc_amt"]:
        L.append("Discount (%s%%): -%s" % (fmt(sale["disc_pct"]), fmt(sale["disc_amt"])))
    if sale["tax_amt"]:
        L.append("Tax (%s%%): %s" % (fmt(sale["tax_pct"]), fmt(sale["tax_amt"])))
    L.append("*TOTAL: %s %s*" % (cur, fmt(sale["total"])))
    L.append("Paid: %s %s (%s)" % (cur, fmt(sale["paid"]), sale["method"]))
    if sale["balance_due"] > 0.004:
        L.append("*Baqaya (Udhar): %s %s*" % (cur, fmt(sale["balance_due"])))
    L += ["", cfg.get("warranty_note", ""), cfg.get("invoice_footer", "")]
    return "\n".join(L)


def wa_number(phone, cc="92"):
    d = re.sub(r"\D", "", phone or "")
    if d.startswith("00"):
        d = d[2:]
    if d.startswith("0"):
        d = cc + d[1:]
    elif len(d) == 10:
        d = cc + d
    return d


def wa_link(phone, text, cc="92"):
    return "https://wa.me/%s?text=%s" % (wa_number(phone, cc), urllib.parse.quote(text))


def invoice_pdf(sale, items, cfg, path):
    """needs reportlab (Thonny: Tools > Manage packages > reportlab). Raises ImportError if missing."""
    from reportlab.lib.pagesizes import A4
    from reportlab.lib import colors
    from reportlab.lib.styles import getSampleStyleSheet
    from reportlab.lib.units import mm
    from reportlab.platypus import SimpleDocTemplate, Paragraph, Table, TableStyle, Spacer
    sale = dict(sale)
    cur = cfg.get("currency", "Rs")
    st = getSampleStyleSheet()
    doc = SimpleDocTemplate(str(path), pagesize=A4, leftMargin=15 * mm, rightMargin=15 * mm, topMargin=15 * mm, bottomMargin=15 * mm)
    E = [Paragraph("<b>%s</b>" % _e(cfg.get("shop_name")), st["Title"]),
         Paragraph("%s | %s" % (_e(cfg.get("shop_address")), _e(cfg.get("shop_phone"))), st["Normal"]), Spacer(1, 8),
         Paragraph("<b>Invoice:</b> %s &nbsp;&nbsp; <b>Date:</b> %s" % (_e(sale["invoice_no"]), _e(sale["date"][:16])), st["Normal"]),
         Paragraph("<b>Customer:</b> %s %s" % (_e(sale.get("customer_name")), _e(sale.get("customer_phone") or "")), st["Normal"]),
         Spacer(1, 10)]
    data = [["#", "Item", "Qty", "Price", "Disc", "Total"]]
    for i, it in enumerate(items, 1):
        name = it["name"] + (("\nIMEI/SN: " + it["imei"]) if it["imei"] else "")
        data.append([str(i), name, fmt(it["qty"]), fmt(it["price"]), ("%s%%" % fmt(it["disc_pct"])) if it["disc_pct"] else "", fmt(it["line_total"])])
    tb = Table(data, colWidths=[10 * mm, 90 * mm, 15 * mm, 25 * mm, 15 * mm, 25 * mm], repeatRows=1)
    tb.setStyle(TableStyle([("BACKGROUND", (0, 0), (-1, 0), colors.HexColor("#E8EDF5")), ("GRID", (0, 0), (-1, -1), 0.4, colors.grey),
                            ("ALIGN", (2, 0), (-1, -1), "RIGHT"), ("VALIGN", (0, 0), (-1, -1), "TOP")]))
    E += [tb, Spacer(1, 10)]
    tdata = [["Subtotal", fmt(sale["subtotal"])]]
    if sale["disc_amt"]:
        tdata.append(["Discount (%s%%)" % fmt(sale["disc_pct"]), "-" + fmt(sale["disc_amt"])])
    if sale["tax_amt"]:
        tdata.append(["Tax (%s%%)" % fmt(sale["tax_pct"]), fmt(sale["tax_amt"])])
    total_idx = len(tdata)
    tdata += [["TOTAL (%s)" % cur, fmt(sale["total"])], ["Paid (%s)" % sale["method"], fmt(sale["paid"])]]
    if sale["balance_due"] > 0.004:
        tdata.append(["Balance Due", fmt(sale["balance_due"])])
    tt = Table(tdata, colWidths=[45 * mm, 30 * mm], hAlign="RIGHT")
    tt.setStyle(TableStyle([("ALIGN", (1, 0), (1, -1), "RIGHT"), ("FONTNAME", (0, total_idx), (-1, total_idx), "Helvetica-Bold")]))
    E += [tt, Spacer(1, 14), Paragraph(_e(cfg.get("warranty_note")), st["Normal"]),
          Paragraph("<b>%s</b>" % _e(cfg.get("invoice_footer")), st["Normal"])]
    doc.build(E)
    return str(path)


