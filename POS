        btn(bar, "Remove (in stock)", self.remove, "danger").pack(side="left", padx=6)
        btn(bar, "Close", self.destroy, "neutral").pack(side="right")
        self.bind("<Escape>", lambda ev: self.destroy())
        self.load()
        self.go_modal(parent, 700, 520)

    def load(self):
        sql = "SELECT u.*, s.invoice_no FROM imei_units u LEFT JOIN sales s ON s.id=u.sale_id WHERE u.product_id=?"
        args = [self.pid]
        st = self.status.get()
        if st == "In Stock":
            sql += " AND u.status='in_stock'"
        elif st == "Sold":
            sql += " AND u.status='sold'"
        if self.q.get().strip():
            sql += " AND u.imei LIKE ?"
            args.append("%" + self.q.get().strip() + "%")
        self.tbl.clear()
        rows = self.db.q(sql + " ORDER BY u.id DESC", args)
        for r in rows:
            self.tbl.add([r["imei"], r["note"], r["cost"], "In stock" if r["status"] == "in_stock" else "Sold", r["invoice_no"] or ""], iid=r["id"])
        self.lbl.config(text="%d unit(s)" % len(rows))

    def add(self):
        res = ask_form(self, "Add IMEIs", [
            {"key": "cost", "label": "Cost per unit", "type": "num", "default": self.p["cost"]},
            {"key": "note", "label": "Color / Storage / Note"},
            {"key": "imeis", "label": "IMEI / Serial numbers (one per line, or scan)", "type": "text", "height": 8}])
        if not res:
            return
        valid, bad = parse_imeis(res["imeis"])
        added, dup = self.db.add_imeis(self.pid, valid, res["cost"], res["note"])
        msg = "%d IMEI added." % added
        if dup:
            msg += "\nAlready exist (skipped): %s" % ", ".join(dup[:6])
        if bad:
            msg += "\nInvalid (6-20 letters/digits): %s" % ", ".join(bad[:6])
        messagebox.showinfo("IMEI", msg, parent=self)
        self.load()

    def remove(self):
        iid = self.tbl.selected()
        if not iid:
            return
        u = self.db.one("SELECT * FROM imei_units WHERE id=?", (int(iid),))
        if u["status"] != "in_stock":
            messagebox.showinfo("Remove", "Sold unit delete nahi ho sakta.", parent=self)
            return
        if messagebox.askyesno("Remove", "IMEI %s delete karein?" % u["imei"], parent=self):
            self.db.x("DELETE FROM imei_units WHERE id=?", (u["id"],))
            self.db.refresh_stock(self.pid)
            self.load()
# =====================================================================================
#  ANIMATION HELPERS  (used by login screen, hover buttons, dashboard counters)
# =====================================================================================
def ease_out(t):
    return 1 - (1 - t) ** 3


def animate(root, duration_ms, on_step, on_done=None, fps=60):
    """Drives on_step(t) with t easing 0->1 over duration_ms. Safe if widgets get destroyed mid-flight."""
    steps = max(1, int(duration_ms / 1000.0 * fps))
    delay = max(1, int(duration_ms / steps))
    state = {"i": 0}

    def tick():
        state["i"] += 1
        t = min(1.0, state["i"] / steps)
        try:
            on_step(ease_out(t))
        except tk.TclError:
            return
        if t < 1.0:
            try:
                root.after(delay, tick)
            except tk.TclError:
                pass
        elif on_done:
            on_done()
    tick()


def flash_border(widget, bad, good, times=3, delay=90):
    seq = []
    for _ in range(times):
        seq += [bad, good]

    def step():
        if not seq:
            return
        c = seq.pop(0)
        try:
            widget.config(highlightbackground=c, highlightcolor=c)
            widget.after(delay, step)
        except tk.TclError:
            pass
    step()


