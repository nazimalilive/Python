        for k, b in self.nav_btns.items():
            b.config(bg=C["accent"] if k == key else C["side"], fg="white" if k == key else "#CBD5E1")
        self.current_key = key
        for w in self.content.winfo_children():
            w.destroy()
        page = cls(self)
        page.pack(fill="both", expand=True)
        page.refresh()
        return page

