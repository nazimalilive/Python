        self.tbl.clear()
        for r in self.db.q("SELECT * FROM users ORDER BY username COLLATE NOCASE"):
            self.tbl.add([r["username"], r["full_name"], r["role"], "Yes" if r["active"] else "No"], iid=r["id"])

    def new_user(self):
        res = ask_form(self, "New User", [
            {"key": "username", "label": "Username", "required": True},
            {"key": "full_name", "label": "Full name"},
            {"key": "role", "label": "Role", "type": "combo", "values": ROLES, "default": "cashier"},
            {"key": "password", "label": "Password", "type": "password", "required": True},
        ])
        if not res:
            return
        if self.db.one("SELECT id FROM users WHERE username=?", (res["username"].strip(),)):
            messagebox.showwarning("Exists", "Ye username pehle se hai.", parent=self)
            return
        self.db.add_user(res["username"], res["password"], res["role"], res["full_name"])
        self.refresh()

    def _sel(self):
        iid = self.tbl.selected()
        return int(iid) if iid else None

    def edit_selected(self):
        uid = self._sel()
        if not uid:
            messagebox.showinfo("Select", "Pehle user select karein.", parent=self)
            return
        u = self.db.one("SELECT * FROM users WHERE id=?", (uid,))
        res = ask_form(self, "Edit User - " + u["username"], [
            {"key": "full_name", "label": "Full name", "default": u["full_name"]},
            {"key": "role", "label": "Role", "type": "combo", "values": ROLES, "default": u["role"]},
            {"key": "password", "label": "New password (khali chorein agar change nahi karna)", "type": "password"},
        ])
        if not res:
            return
        if u["role"] == "admin" and res["role"] != "admin" and self.db.admin_count() <= 1:
            messagebox.showwarning("Blocked", "Kam az kam ek admin hona zaroori hai.", parent=self)
            return
        self.db.x("UPDATE users SET full_name=?, role=? WHERE id=?", (res["full_name"], res["role"], uid))
        if res["password"].strip():
            self.db.set_password(uid, res["password"], must_change=1)
        self.refresh()

    def toggle_active(self):
        uid = self._sel()
        if not uid:
            return
        u = self.db.one("SELECT * FROM users WHERE id=?", (uid,))
        if u["role"] == "admin" and u["active"] and self.db.admin_count() <= 1:
            messagebox.showwarning("Blocked", "Aakhri active admin ko disable nahi kar sakte.", parent=self)
            return
        if u["id"] == self.app.user["id"]:
            messagebox.showwarning("Blocked", "Apna hi account disable nahi kar sakte.", parent=self)
            return
        self.db.x("UPDATE users SET active=? WHERE id=?", (0 if u["active"] else 1, uid))
        self.refresh()


