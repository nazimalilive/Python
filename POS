class HoverButton(tk.Label):
    """Flat button with smooth colour-fade hover animation."""

    def __init__(self, parent, text, command=None, bg=None, hover=None, fg="white", font=None, padx=14, pady=7):
        base = bg or C["accent"]
        super().__init__(parent, text=text, bg=base, fg=fg, font=font or FONT_B, padx=padx, pady=pady, cursor="hand2")
        self.base, self.hov, self.cmd = base, hover or C["accent2"], command
        self._t, self._dir, self._job = 0.0, 0, None
        self.bind("<Enter>", lambda e: self._go(1))
        self.bind("<Leave>", lambda e: self._go(-1))
        self.bind("<Button-1>", self._click)

    def _go(self, d):
        self._dir = d
        if self._job is None:
            self._step()

    def _step(self):
        self._job = None
        self._t = min(1.0, max(0.0, self._t + 0.25 * self._dir))
        try:
            self.config(bg=lerp_color(self.base, self.hov, self._t))
            if (self._dir > 0 and self._t < 1.0) or (self._dir < 0 and self._t > 0.0):
                self._job = self.after(18, self._step)
        except tk.TclError:
            pass

    def _click(self, _e=None):
        if self.cmd:
            self.cmd()


