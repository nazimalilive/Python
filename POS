    def refresh(self):
        db = self.db
        today = today_str()
        month_start = today[:8] + "01"
        s_today = db.summary(today, today)
        s_month = db.summary(month_start, today)
        targets = {
            "today": s_today["gross_sales"],
            "month_profit": s_month["net_profit"],
            "receivable": db.receivable(),
            "payable": db.payable(),
            "low_stock": len(db.low_stock()),
            "repairs": db.pending_repairs(),
        }
        for key, tgt in targets.items():
            self._count_up(self.cards[key], to_num(tgt), integer=(key in self.COUNT_KEYS))
        self.low_tbl.clear()
        for p in db.low_stock()[:30]:
            self.low_tbl.add([p["name"], p["stock"], p["min_stock"]], iid=p["id"], tags=("low",))
        self.recent_tbl.clear()
        for r in db.q("SELECT s.id, s.invoice_no, s.total, c.name cn FROM sales s LEFT JOIN customers c ON c.id=s.customer_id "
                      "ORDER BY s.id DESC LIMIT 10"):
            self.recent_tbl.add([r["invoice_no"], r["cn"], r["total"]], iid=r["id"])

        days = []
        for i in range(6, -1, -1):
            d = (datetime.now() - timedelta(days=i)).strftime("%Y-%m-%d")
            s = db.summary(d, d)
            days.append((d[5:], s["gross_sales"]))
        self._chart_data = days
        self.after(50, lambda: self._draw_chart(animate_in=True))

        self._pm_data = [(r["method"], r["amt"]) for r in db.q(
            "SELECT method, SUM(total) amt FROM sales WHERE substr(date,1,10)=? GROUP BY method ORDER BY amt DESC", (today,))]
        self.after(50, self._draw_payment_bar)

    def _count_up(self, label, target, integer=False):
        def step(t):
            v = target * t
            text = str(int(round(v))) if integer else fmt(v)
            try:
                label.config(text=text)
            except tk.TclError:
                pass
        animate(self.app, 450, step)

    def _draw_chart(self, animate_in=False):
        c = self.chart
        data = self._chart_data
        try:
            w = c.winfo_width()
            h = int(c.cget("height"))
        except tk.TclError:
            return
        if w < 20:
            return
        c.delete("all")
        if not data:
            return
        maxv = max((v for _, v in data), default=0) or 1
        n = len(data)
        gap = 10
        bw = max(18, (w - gap * (n + 1)) / n)

        def draw(t):
            try:
                c.delete("bar")
                for i, (lbl, val) in enumerate(data):
                    x0 = gap + i * (bw + gap)
                    bh = (val / maxv) * (h - 30) * t
                    y0 = h - 20 - bh
                    c.create_rectangle(x0, y0, x0 + bw, h - 20, fill=C["accent"], width=0, tags="bar")
                    c.create_text(x0 + bw / 2, h - 10, text=lbl, fill=C["mute"], font=FONT_S, tags="bar")
                    if t > 0.9 and val:
                        c.create_text(x0 + bw / 2, y0 - 8, text=fmt(val), fill=C["text"], font=FONT_S, tags="bar")
            except tk.TclError:
                pass
        if animate_in:
            animate(self.app, 500, draw)
        else:
            draw(1.0)

    def _draw_payment_bar(self):
        c = self.pm_canvas
        try:
            w = c.winfo_width()
            h = int(c.cget("height"))
        except tk.TclError:
            return
        if w < 20:
            return
        c.delete("all")
        for ch in self.pm_legend.winfo_children():
            ch.destroy()
        data = self._pm_data
        total = sum(amt for _, amt in data)
        if not data or total <= 0:
            c.create_rectangle(0, 0, w, h, fill=C["line"], width=0)
            tk.Label(self.pm_legend, text="Aaj abhi tak koi sale nahi.", bg=C["card"], fg=C["mute"], font=FONT_S)\
                .pack(side="left")
            return
        palette = [C["accent"], C["ok"], C["warn"], C["bad"], C["neutral"], C["accent2"]]
        x = 0.0
        for i, (method, amt) in enumerate(data):
            seg = (amt / total) * w
            color = palette[i % len(palette)]
            c.create_rectangle(x, 0, x + seg, h, fill=color, width=0)
            x += seg
            chip = tk.Frame(self.pm_legend, bg=C["card"])
            chip.pack(side="left", padx=(0, 14), pady=(0, 4))
            tk.Label(chip, text="  ", bg=color, width=2).pack(side="left")
            tk.Label(chip, text=" %s: %s" % (method, fmt(amt)), bg=C["card"], fg=C["text"], font=FONT_S).pack(side="left")

    def _open_low_item(self):
        iid = self.low_tbl.selected()
        if not iid:
            return
        row = self.db.one("SELECT name FROM products WHERE id=?", (int(iid),))
        page = self.app.show_page("products")
        if page is not None and row is not None:
            page.qv.set(row["name"])
            page.refresh()

    def _open_sale(self):
        iid = self.recent_tbl.selected()
        if not iid:
            return
        InvoiceDialog(self.app, self.app, int(iid), done=False)


