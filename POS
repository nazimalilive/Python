    def pick_sup(self):
        sid = pick_supplier(self, self.db)
        if sid:
            self.supplier_id = sid
            row = self.db.one("SELECT name FROM suppliers WHERE id=?", (sid,))
            self.supplier_name = row["name"] if row else ""
            self.sup_lbl.config(text="Supplier: " + self.supplier_name)

    def search(self):
        self.presults.clear()
        t = self.pv.get().strip()
        if not t:
            return
        for p in self.db.search_products(t, limit=8):
            self.presults.add([p["name"], p["brand"], p["cost"]], iid=p["id"])

    def add_from_search(self):
        iid = self.presults.selected()
        if not iid:
            return
        p = self.db.one("SELECT * FROM products WHERE id=?", (int(iid),))
        if not p:
            return
        if p["track_imei"]:
            res = ask_form(self, "IMEI / Serial for " + p["name"], [
                {"key": "cost", "label": "Cost per unit", "type": "num", "default": p["cost"]},
                {"key": "imeis", "label": "IMEI / Serial numbers (one per line)", "type": "text", "height": 6},
            ], ok_text="Add")
            if not res:
                return
            valid, bad = parse_imeis(res["imeis"])
            if not valid:
                messagebox.showwarning("IMEI", "Koi valid IMEI nahi mila.", parent=self)
                return
            if bad:
                messagebox.showinfo("IMEI", "Invalid (ignore ho gaye): %s" % ", ".join(bad[:6]), parent=self)
            self.lines.append({"pid": p["id"], "name": p["name"], "qty": len(valid), "cost": res["cost"],
                              "imeis": valid, "note": ""})
        else:
            res = ask_form(self, "Qty / Cost for " + p["name"], [
                {"key": "qty", "label": "Quantity", "type": "num", "required": True, "default": 1},
                {"key": "cost", "label": "Cost per unit", "type": "num", "required": True, "default": p["cost"]},
            ], ok_text="Add")
            if not res:
                return
            self.lines.append({"pid": p["id"], "name": p["name"], "qty": res["qty"], "cost": res["cost"]})
        self.pv.set("")
        self.presults.clear()
        self.refresh_lines()

    def edit_line(self):
        iid = self.line_tbl.selected()
        if iid is None:
            return
        idx = int(iid)
        if messagebox.askyesno("Remove", "Ye line remove kar dein?", parent=self):
            del self.lines[idx]
            self.refresh_lines()

    def refresh_lines(self):
        self.line_tbl.clear()
        for i, l in enumerate(self.lines):
            self.line_tbl.add([l["name"], l["qty"], l["cost"], round(l["qty"] * l["cost"], 2)], iid=i)
        self.recalc()

    def recalc(self):
        sub = round(sum(l["qty"] * l["cost"] for l in self.lines), 2)
        disc = to_num(self.discv.get())
        total = round(sub - sub * disc / 100.0, 2)
        self.tot_lbl.config(text=fmt(total))
        self.paidv.set(fmt(total))

    def save(self):
        if not self.supplier_id:
            messagebox.showwarning("Supplier", "Pehle supplier select karein.", parent=self)
            return
        if not self.lines:
            messagebox.showwarning("Empty", "Kam az kam ek item add karein.", parent=self)
            return
        try:
            pid = self.db.create_purchase(self.supplier_id, self.lines, to_num(self.discv.get()),
                                          to_num(self.paidv.get()), self.methodv.get(), "", self.app.user["id"])
        except ValueError as e:
            messagebox.showerror("Purchase", str(e), parent=self)
            return
        self.result = pid
        messagebox.showinfo("Saved", "Purchase save ho gayi.", parent=self)
        self.destroy()


