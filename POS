def center_on(win, parent=None, w=None, h=None):
    win.update_idletasks()
    w = w or win.winfo_reqwidth()
    h = h or win.winfo_reqheight()
    if parent is not None:
        top = parent.winfo_toplevel()
        x = top.winfo_rootx() + (top.winfo_width() - w) // 2
        y = top.winfo_rooty() + (top.winfo_height() - h) // 2
    else:
        x = (win.winfo_screenwidth() - w) // 2
        y = (win.winfo_screenheight() - h) // 2
    win.geometry("%dx%d+%d+%d" % (w, h, max(0, x), max(0, y)))


class Modal(tk.Toplevel):
    def __init__(self, parent):
        super().__init__(parent)
        self._prev = None

    def go_modal(self, parent, w=None, h=None):
        self.transient(parent.winfo_toplevel())
        center_on(self, parent, w, h)
        try:
            self._prev = self.grab_current()
        except tk.TclError:
            self._prev = None
        try:
            self.wait_visibility()
            self.grab_set()
        except tk.TclError:
            pass
        self.focus_set()

    def destroy(self):
        prev = self._prev
        super().destroy()
        if prev is not None:
            try:
                prev.grab_set()
            except tk.TclError:
                pass


def _fmtv(v):
    if v is None:
        return ""
    if isinstance(v, bool):
        return "Yes" if v else "No"
    if isinstance(v, (int, float)):
        return fmt(v)
    return str(v)


def _sortkey(s):
    try:
        return (0, float(str(s).replace(",", "")), "")
    except ValueError:
        return (1, 0.0, str(s).lower())


class Table(tk.Frame):
    """Treeview with scrollbar, zebra rows and click-to-sort headings."""

    def __init__(self, parent, cols, height=10, on_double=None, on_select=None):
        super().__init__(parent, bg=C["card"], highlightthickness=1, highlightbackground=C["line"])
        self.cols = cols
        self.keys = [c[0] for c in cols]
        self.tree = ttk.Treeview(self, columns=self.keys, show="headings", height=height, selectmode="browse")
        for key, head, w, anc in cols:
            self.tree.heading(key, text=head, command=lambda k=key: self.sort_by(k))
            self.tree.column(key, width=w, anchor=anc, stretch=True)
        vsb = ttk.Scrollbar(self, orient="vertical", command=self.tree.yview)
        self.tree.configure(yscrollcommand=vsb.set)
        self.tree.grid(row=0, column=0, sticky="nsew")
        vsb.grid(row=0, column=1, sticky="ns")
        self.grid_rowconfigure(0, weight=1)
        self.grid_columnconfigure(0, weight=1)
        self.tree.tag_configure("odd", background="#F8FAFC")
        self.tree.tag_configure("low", foreground=C["bad"])
        self.tree.tag_configure("total", background="#E8EDF5", font=FONT_B)
        self.tree.tag_configure("ok", foreground=C["ok"])
        self._n, self._vals, self._rev = 0, {}, {}
        if on_double:
            self.tree.bind("<Double-1>", lambda e: on_double())
        if on_select:
            self.tree.bind("<<TreeviewSelect>>", lambda e: on_select())

    def clear(self):
        self.tree.delete(*self.tree.get_children())
        self._n, self._vals = 0, {}

    def add(self, values, iid=None, tags=()):
        vals = [_fmtv(v) for v in values]
        iid = str(iid) if iid is not None else "r%d" % self._n
        if not tags and self._n % 2:
            tags = ("odd",)
        self.tree.insert("", "end", iid=iid, values=vals, tags=tags)
        self._vals[iid] = vals
        self._n += 1
        return iid

    def selected(self):
        sel = self.tree.selection()
        return sel[0] if sel else None

    def select_first(self):
        kids = self.tree.get_children()
        if kids:
            self.tree.selection_set(kids[0])
            self.tree.focus(kids[0])

    def count(self):
        return self._n

    def sort_by(self, key):
        idx = self.keys.index(key)
        rev = self._rev.get(key, False)
        items = sorted(self.tree.get_children(""), key=lambda i: _sortkey(self._vals[i][idx]), reverse=rev)
        for pos, i in enumerate(items):
            self.tree.move(i, "", pos)
        self._rev[key] = not rev
        for pos, i in enumerate(self.tree.get_children("")):
            t = [x for x in self.tree.item(i, "tags") if x != "odd"]
            if pos % 2 and not t:
                t = ["odd"]
            self.tree.item(i, tags=tuple(t))


